node_modules
node_modules/

# Tests and development tooling
tests
tests/
.phpunit.result.cache
.phpunit.cache

# Local environment files
.env
.env.local
.env.*.local

# IDE / operating system files
.idea
.idea/
.vscode
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Generated archives
*.zip
*.tar
*.tar.gz